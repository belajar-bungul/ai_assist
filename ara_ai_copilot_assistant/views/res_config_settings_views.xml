<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_ai_copilot" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.copilot</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Ara AI Copilot" string="Ara AI Copilot" name="ara_ai_copilot_assistant">
                    <block title="AI Providers &amp; Authentication">
                        <setting string="Default Provider" help="Select the default AI provider for all users">
                            <field name="copilot_provider_id"/>
                        </setting>
                        <setting string="Google Gemini API Key" help="Used for Google Gemini Pro / Flash models">
                            <field name="copilot_gemini_api_key" password="True"/>
                        </setting>
                        <setting string="OpenAI API Key" help="Used for OpenAI GPT-4o / GPT-4o-mini">
                            <field name="copilot_openai_api_key" password="True"/>
                        </setting>
                        <setting string="Claude API Key" help="Used for Anthropic Claude 3.7 / 3.5 Sonnet">
                            <field name="copilot_claude_api_key" password="True"/>
                        </setting>
                        <setting string="OpenRouter API Key" help="Used for 100+ models via OpenRouter (DeepSeek, Llama, etc.)">
                            <field name="copilot_openrouter_api_key" password="True"/>
                        </setting>
                    </block>
                    <block title="Enterprise Safety &amp; Governance">
                        <setting string="Approval Gate for Data Changes" help="Require explicit user confirmation button before any Create, Update, Email, or Server Action executes">
                            <field name="copilot_require_approval"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

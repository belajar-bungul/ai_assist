<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thread List View -->
    <record id="view_ai_copilot_thread_tree" model="ir.ui.view">
        <field name="name">ai.copilot.thread.list</field>
        <field name="model">ai.copilot.thread</field>
        <field name="arch" type="xml">
            <list string="Conversations" decoration-muted="active == False">
                <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="provider_id"/>
                <field name="write_date" string="Last Active"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Thread Form View -->
    <record id="view_ai_copilot_thread_form" model="ir.ui.view">
        <field name="name">ai.copilot.thread.form</field>
        <field name="model">ai.copilot.thread</field>
        <field name="arch" type="xml">
            <form string="Conversation Thread">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Topic"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="provider_id"/>
                        </group>
                        <group>
                            <field name="write_date" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messages History">
                            <field name="message_ids" readonly="1">
                                <list string="Messages">
                                    <field name="create_date" string="Time"/>
                                    <field name="role" widget="badge"/>
                                    <field name="content"/>
                                    <field name="approval_state" widget="badge"
                                           decoration-warning="approval_state == 'pending'"
                                           decoration-success="approval_state == 'approved'"
                                           decoration-danger="approval_state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_copilot_thread" model="ir.actions.act_window">
        <field name="name">Conversations History</field>
        <field name="res_model">ai.copilot.thread</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

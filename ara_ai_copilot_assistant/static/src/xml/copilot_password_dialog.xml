<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ara_ai_copilot_assistant.PasswordConfirmDialog">
        <Dialog size="'md'" title="props.title">
            <div class="ara-password-dialog-body p-2">
                <div class="d-flex align-items-start gap-3 mb-3 p-3 bg-light rounded-3 border">
                    <div class="ara-shield-badge flex-shrink-0 text-danger" style="font-size: 26px;">
                        <i class="fa fa-shield"/>
                    </div>
                    <div>
                        <div class="fw-bold text-danger mb-1">
                            Authentication Required
                        </div>
                        <div class="text-muted small">
                            <t t-esc="props.body || 'To delete this AI conversation session permanently, please enter your user account password to verify your identity.'"/>
                        </div>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-bold small text-dark mb-1">
                        Enter Your User Password:
                    </label>
                    <div class="input-group">
                        <input
                            t-ref="passwordInput"
                            t-att-type="state.showPassword ? 'text' : 'password'"
                            class="form-control"
                            placeholder="Your current user login password..."
                            t-model="state.password"
                            t-on-input="onInput"
                            t-on-keydown="onKeyDown"
                            autocomplete="current-password"
                        />
                        <button class="btn btn-outline-secondary" type="button" t-on-click="toggleShowPassword" title="Show/Hide Password">
                            <i t-attf-class="fa #{state.showPassword ? 'fa-eye-slash' : 'fa-eye'}"/>
                        </button>
                    </div>

                    <div t-if="state.errorMessage" class="alert alert-danger py-2 px-3 mt-2 mb-0 d-flex align-items-center gap-2 small">
                        <i class="fa fa-exclamation-triangle flex-shrink-0"/>
                        <span t-esc="state.errorMessage"/>
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-danger" t-att-disabled="state.isSubmitting or !state.password" t-on-click="onConfirm">
                    <i t-if="state.isSubmitting" class="fa fa-spinner fa-spin me-1"/>
                    <i t-else="" class="fa fa-trash me-1"/>
                    <t t-esc="props.confirmLabel"/>
                </button>
                <button class="btn btn-secondary" t-att-disabled="state.isSubmitting" t-on-click="onCancel">
                    <t t-esc="props.cancelLabel"/>
                </button>
            </t>
        </Dialog>
    </t>

</templates>

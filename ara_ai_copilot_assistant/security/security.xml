<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_ai_copilot">
        <field name="name">Ara AI Copilot</field>
        <field name="sequence">30</field>
        <field name="parent_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_ai_copilot_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_ai_copilot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ai_copilot_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_ai_copilot"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_copilot_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_ai_copilot_thread_user" model="ir.rule">
        <field name="name">Personal Copilot Threads</field>
        <field name="model_id" ref="model_ai_copilot_thread"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_copilot_user'))]"/>
    </record>

    <record id="rule_ai_copilot_thread_manager" model="ir.rule">
        <field name="name">Manager All Copilot Threads</field>
        <field name="model_id" ref="model_ai_copilot_thread"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_copilot_manager'))]"/>
    </record>
</odoo>
